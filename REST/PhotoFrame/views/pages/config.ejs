<%- include('../partials/head') %>
<section class="sample-content">
	<div>
		<h2>Slideshow Configuration</h2>
	</div>
	<form id="config-form">
		<!-- Numeric Textfield with Floating Label -->
		<div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label">
			<input class="mdl-textfield__input" type="text" pattern="-?[0-9]*(\.[0-9]+)?" required id="input-interval">
			<label class="mdl-textfield__label" for="input-interval">Slideshow Interval [s]</label>
			<span class="mdl-textfield__error">Input is not a number!</span>
		</div>
		<!-- Numeric Textfield with Floating Label -->
		<div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label">
			<input class="mdl-textfield__input" type="text" pattern="-?[0-9]*(\.[0-9]+)?" required id="input-update">
			<label class="mdl-textfield__label" for="input-update">Minimum time to refresh album or search [m]</label>
			<span class="mdl-textfield__error">Input is not a number!</span>
		</div>
		<!-- Numeric Textfield with Floating Label -->
		<div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label">
			<input class="mdl-textfield__input" type="text" pattern="-?[0-9]*(\.[0-9]+)?" required id="input-cycles">
			<label class="mdl-textfield__label" for="input-cycles">Cycles after Queue will be randomized</label>
			<span class="mdl-textfield__error">Input is not a number!</span>
		</div>
		<!-- Checkbox with Floating Label -->
		<label class="mdl-checkbox mdl-js-checkbox mdl-js-ripple-effect" for="checkbox-mqtt" id="label-mqtt">
			<input type="checkbox" id="checkbox-mqtt" class="mdl-checkbox__input">
			<span class="mdl-checkbox__label">Enable MQTT</span>
		</label>
		<!-- Textfield with Floating Label -->
		<div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label">
			<input class="mdl-textfield__input" type="text" required id="input-mqtt-host">
			<label class="mdl-textfield__label" for="input-mqtt-host">Host</label>
		</div>
		<!-- Numeric Textfield with Floating Label -->
		<div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label">
			<input class="mdl-textfield__input" type="text" pattern="-?[0-9]*(\.[0-9]+)?" required id="input-mqtt-port">
			<label class="mdl-textfield__label" for="input-mqtt-port">Port</label>
			<span class="mdl-textfield__error">Input is not a number!</span>
		</div>
		<!-- Textfield with Floating Label -->
		<div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label">
			<input class="mdl-textfield__input" type="text" id="input-mqtt-username">
			<label class="mdl-textfield__label" for="input-mqtt-username">Username</label>
		</div>
		<!-- Textfield with Floating Label -->
		<div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label">
			<input class="mdl-textfield__input" type="password" id="input-mqtt-password">
			<label class="mdl-textfield__label" for="input-mqtt-password">Password</label>
		</div>
		<!-- Textfield with Floating Label -->
		<div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label">
			<input class="mdl-textfield__input" type="text" required id="input-mqtt-topic">
			<label class="mdl-textfield__label" for="input-mqtt-topic">Topic</label>
		</div>

		<div class="floating-button">
			<button class="mdl-button mdl-js-button mdl-button--raised mdl-button--accent" type="submit" id="button-save">
				<i class="material-icons">save</i>
				<span class="float-btn-label">Save</span>
			</button>
		</div>
	</form>
</section>

<%- include('../partials/dialogs') %>

<%- include('../partials/js') %>
<script src="/js/config.js"></script>

<%- include('../partials/footer') %>
